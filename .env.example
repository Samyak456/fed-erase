# FedErase — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Phase 1 uses no secrets — all settings are in experiments/configs/*.yaml.
# This file documents variables that will be needed in later phases.

# ---------------------------------------------------------------------------
# Paths (Phase 1)
# Override the default data and checkpoint directories if needed.
# Default values are relative to the project root.
# ---------------------------------------------------------------------------

# Directory where CIFAR-10 will be downloaded and cached.
# Default: data/cifar10  (set in experiments/configs/phase1_baseline.yaml)
# FEDERASE_DATA_DIR=data/cifar10

# Directory where model checkpoints are saved.
# Default: checkpoints/phase1  (set in experiments/configs/phase1_baseline.yaml)
# FEDERASE_CHECKPOINT_DIR=checkpoints/phase1

# Directory where log files are written.
# Default: logs  (set in experiments/configs/phase1_baseline.yaml)
# FEDERASE_LOG_DIR=logs

# ---------------------------------------------------------------------------
# PostgreSQL (Phase 12+)
# ---------------------------------------------------------------------------

# POSTGRES_USER=federase
# POSTGRES_PASSWORD=change_me_before_use
# POSTGRES_DB=federase
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Full connection URL (alternative to individual vars above)
# DATABASE_URL=postgresql+psycopg2://federase:change_me@localhost:5432/federase

# ---------------------------------------------------------------------------
# FastAPI (Phase 11+)
# ---------------------------------------------------------------------------

# Secret key used for request signing. Generate with: openssl rand -hex 32
# API_SECRET_KEY=change_me_in_production

# API host and port
# API_HOST=0.0.0.0
# API_PORT=8000

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Experiment tracking (optional, Phase 11+)
# ---------------------------------------------------------------------------

# MLflow tracking URI (optional)
# MLFLOW_TRACKING_URI=http://localhost:5000

# Weights & Biases API key (optional)
# WANDB_API_KEY=your_wandb_key_here
# WANDB_PROJECT=fed-erase
